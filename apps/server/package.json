{
  "name": "@intrica/server",
  "license": "MIT",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": "./runtime.mjs"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json && node ../../scripts/build-metadata.mjs dist/build.json && node --check runtime.mjs && node --check service.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "pnpm build && node --env-file-if-exists=.env dist/server.js",
    "start": "node dist/server.js",
    "postinstall": "node scripts/prepare-pty.mjs",
    "worker": "node dist/entrypoints/worker.js",
    "migrate": "node dist/entrypoints/migrate.js"
  },
  "bin": {
    "intrica-server": "dist/server.js"
  },
  "dependencies": {
    "@intrica/releases": "workspace:*",
    "@fastify/multipart": "10.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@intrica/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@vscode/ripgrep": "1.18.0",
    "@napi-rs/canvas": "1.0.9",
    "pdfjs-dist": "6.3.289",
    "fastify": "5.12.3",
    "node-pty": "1.1.0",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "typebox": "1.3.25",
    "@earendil-works/pi-agent-core": "0.85.0",
    "@earendil-works/pi-ai": "0.85.0",
    "cron-parser": "5.10.0",
    "embedded-postgres": "18.4.0-beta.17"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "files": [
    "dist",
    "runtime.mjs",
    "service.mjs",
    "scripts/prepare-pty.mjs"
  ]
}
